# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Session configuration
# For local run: SESSION_NAME stores session on disk
SESSION_NAME=my_userbot
# For headless 24/7 cloud deployments (Render, Koyeb, Railway): paste output from 'python generate_session.py'
SESSION_STRING=

# Web service port (set automatically by cloud hosts like Render/Koyeb)
PORT=8080

# Command prefix for userbot commands (default is .)
COMMAND_PREFIX=.

# Optional: List of comma-separated Telegram User IDs allowed to trigger commands (Sudo users)
# Leave blank if only you want to execute commands.
SUDO_USERS=

# Optional: Userbot Log Channel (ID, @username, or 'me' for Saved Messages)
LOG_CHANNEL=me

# Optional: TeraBox 'ndus' session cookie (from browser devtools) to unlock direct streaming
TERABOX_COOKIE=

# Optional: Third-Party / Scraper Proxy settings (as used in rishi058/TeraBox-Video-Downloader)
TERABOX_PROXY_URL=
DISKWALA_PROXY_URL=
DISKWALA_API_KEY=


